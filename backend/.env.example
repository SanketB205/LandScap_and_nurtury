# =============================================================================
# Janai Landscape Services - Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values before deployment.
# NEVER commit real .env files to version control.

# Server
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas or self-hosted)
# Require authenticated connections with TLS in production.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/janai-landscape?retryWrites=true&w=majority

# JWT Secret - MUST be cryptographically strong (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters

# Cookie / Session security
# Set to your production frontend domain (e.g. https://janailandscape.com)
CLIENT_URL=https://janailandscape.com

# CORS - comma-separated list of allowed origins (no spaces)
# In production, list only your verified custom domain(s).
ALLOWED_ORIGINS=https://janailandscape.com,https://www.janailandscape.com

# SameSite cookie mode: "lax" or "strict". Use "lax" for standard web flows.
COOKIE_SAMESITE=lax

# =============================================================================
# Image Storage (Cloudinary) - Required for production uploads
# =============================================================================
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_KEY=your_cloudinary_api_key
CLOUD_SECRET=your_cloudinary_api_secret

# =============================================================================
# Email Notifications (Transactional provider - Resend, SendGrid, Mailgun, etc.)
# Configure at least one provider before launch.
# =============================================================================
# Example using Resend:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# NOTIFICATION_EMAIL=contact@janailandscape.com
# EMAIL_FROM=Janai Landscape <contact@janailandscape.com>

# =============================================================================
# Security
# =============================================================================
# Rate limiting windows (in minutes)
AUTH_RATE_LIMIT_WINDOW=15
AUTH_RATE_LIMIT_MAX=30
INQUIRY_RATE_LIMIT_WINDOW=15
INQUIRY_RATE_LIMIT_MAX=20

# =============================================================================
# Optional: Error tracking (Sentry)
# =============================================================================
# SENTRY_DSN=https://xxx@sentry.io/yyy

# =============================================================================
# Optional: Analytics (only after consent/privacy disclosure)
# =============================================================================
# GA_MEASUREMENT_ID=G-XXXXXXXXXX