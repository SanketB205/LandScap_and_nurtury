# =============================================================================
# Janai Landscape Services - Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values before deployment.
# NEVER commit real .env files to version control.
# NEVER put backend secrets here - VITE_* variables are exposed to the browser.

# Backend API base URL (no trailing slash)
# Development: http://localhost:5000/api
# Production:  https://api.janailandscape.com/api  (your actual backend domain)
VITE_API_URL=http://localhost:5000/api

# Site title
VITE_SITE_TITLE=Janai Landscape Services - Pune

# Optional: Google Analytics (only after privacy disclosure)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX